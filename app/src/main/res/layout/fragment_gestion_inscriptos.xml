<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

  <TextView
      android:id="@+id/tvTitulo"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Pagos"
      android:textSize="20sp"
      android:textStyle="bold"
      android:textColor="@color/black"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"/>

  <TextView
      android:id="@+id/tvMensajeGlobal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="8dp"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:visibility="gone"
      android:textStyle="bold"
      android:background="#EEEEEE"
      app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

  <com.google.android.material.chip.ChipGroup
      android:id="@+id/chipGroupFiltros"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      app:chipSpacingHorizontal="16dp"
      app:singleSelection="true"
      app:selectionRequired="true"
      app:layout_constraintTop_toBottomOf="@id/tvMensajeGlobal"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <com.google.android.material.chip.Chip
        android:id="@+id/chipProcesando"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Procesando"
        android:textColor="#EF6C00"
        android:checked="true"/>

    <com.google.android.material.chip.Chip
        android:id="@+id/chipPagado"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirmados"
        android:textColor="#2E7D32"/>

    <!-- Deshabilitado: en Gestion de Pagos solo se muestran pagos enviados y confirmados
    <com.google.android.material.chip.Chip
        android:id="@+id/chipPendiente"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pendientes de Pago"/>
    -->
  </com.google.android.material.chip.ChipGroup>

  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/recyclerInscriptos"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      app:layout_constraintTop_toBottomOf="@id/chipGroupFiltros"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  <ProgressBar
      android:id="@+id/progressBar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  <TextView
      android:id="@+id/tvVacio"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="No hay inscripciones en este estado"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>