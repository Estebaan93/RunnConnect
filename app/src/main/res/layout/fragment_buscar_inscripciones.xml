<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.organizador.buscarInscripciones.BuscarInscripcionesFragment">

    <!-- titulo -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscar Inscriptos"
        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- barra de busqueda -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchViewBusqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:queryHint="Buscar por DNI, nombre o apellido..."
        app:iconifiedByDefault="false"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- nmnsaje de estado (vacio o error) -->
    <TextView
        android:id="@+id/tvEstadoBusqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#666666"
        android:textAlignment="center"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/searchViewBusqueda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- recyclerView (ocupa el resto de la pantalla) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBusqueda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/item_busqueda_global"
        app:layout_constraintTop_toBottomOf="@id/searchViewBusqueda"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>