<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSubtituloReset"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ingresa y confirma tu nueva contraseña. Debe tener al menos 6 caracteres."
        android:textColor="#A0A0A0"
        android:textSize="15sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etNuevaPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="32dp"
        android:hint="Nueva contraseña"
        android:textColorHint="#A0A0A0"
        android:textColor="#FFFFFF"
        android:inputType="textPassword"
        android:backgroundTint="#FF9800"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloReset" />

    <EditText
        android:id="@+id/etConfirmarPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:hint="Confirmar contraseña"
        android:textColorHint="#A0A0A0"
        android:textColor="#FFFFFF"
        android:inputType="textPassword"
        android:backgroundTint="#FF9800"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/etNuevaPassword" />

    <TextView
        android:id="@+id/tvErrorReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#F44336"
        android:textSize="14sp"
        android:textAlignment="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/etConfirmarPassword" />

    <TextView
        android:id="@+id/tvExitoReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:textAlignment="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/etConfirmarPassword" />

    <Button
        android:id="@+id/btnGuardarPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="40dp"
        android:text="Guardar Contraseña"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etConfirmarPassword" />

    <ProgressBar
        android:id="@+id/pbResetPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:indeterminateTint="#FF9800"
        app:layout_constraintTop_toBottomOf="@id/btnGuardarPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>