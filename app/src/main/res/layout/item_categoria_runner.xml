<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="14dp">

    <!-- Fila 1: Nombre y Precio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <TextView
          android:id="@+id/tvCatNombre"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Categoría"
          android:textSize="17sp"
          android:textStyle="bold"
          android:textColor="@color/black" />

      <TextView
          android:id="@+id/tvCatPrecio"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="$0.00"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="#2E7D32" />
    </LinearLayout>

    <!-- Fila 2: Requisitos (Edad y Género) -->
    <TextView
        android:id="@+id/tvCatRequisitos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="6dp"
        android:text="Edad: 18 - 99 años | Género: Mixto"
        android:textSize="13sp"
        android:textColor="#616161"
        app:drawableStartCompat="@android:drawable/ic_menu_info_details" />

    <!-- Fila 3: Cupos disponibles -->
    <TextView
        android:id="@+id/tvCatCupos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawablePadding="6dp"
        android:text="Cupos: - / -"
        android:textSize="13sp"
        android:textColor="#616161"
        app:drawableStartCompat="@android:drawable/ic_menu_myplaces" />

    <!-- Fila 4: Estado de compatibilidad (Badge explicativo solo si no es compatible) -->
    <TextView
        android:id="@+id/tvCatCompatibilidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:text=""
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#757575"
        android:visibility="gone" />

    <!-- Fila 5: Botón Inscribirse (Visible siempre, habilitado si es compatible) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInscribirme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="INSCRIBIRSE"
        android:textStyle="bold"
        app:backgroundTint="@color/selector_btn_inscribirme"
        android:textColor="@color/selector_btn_inscribirme_text"
        android:visibility="visible" />

  </LinearLayout>

</androidx.cardview.widget.CardView>
