<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

  <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Mensaje persistente superior (Exito / Error) -->
      <TextView
          android:id="@+id/tvMensajeDetalle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:padding="12dp"
          android:background="#FFEBEE"
          android:textColor="#C62828"
          android:textSize="14sp"
          android:textStyle="bold"
          android:gravity="center"
          android:visibility="gone" />

      <!-- Tarjeta 1: Información Principal del Evento -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTituloDetalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cargando evento..."
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvEstadoDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner_border"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PUBLICADO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />
          </LinearLayout>

          <TextView
              android:id="@+id/tvFechaDetalle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="10dp"
              android:drawablePadding="8dp"
              android:text="Fecha: --/--/----"
              android:textSize="15sp"
              android:textColor="#424242"
              app:drawableStartCompat="@android:drawable/ic_menu_my_calendar" />

          <TextView
              android:id="@+id/tvLugarDetalle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:drawablePadding="8dp"
              android:text="Lugar: ---"
              android:textSize="15sp"
              android:textColor="#424242"
              app:drawableStartCompat="@android:drawable/ic_menu_mylocation" />

          <TextView
              android:id="@+id/tvCuposDetalle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:drawablePadding="8dp"
              android:text="Cupos disponibles: ---"
              android:textSize="14sp"
              android:textColor="#616161"
              app:drawableStartCompat="@android:drawable/ic_menu_myplaces" />

          <!-- Botón Ver Recorrido en Mapa -->
          <com.google.android.material.button.MaterialButton
              android:id="@+id/btnVerRecorrido"
              style="@style/Widget.MaterialComponents.Button.OutlinedButton"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:text="VER RECORRIDO EN MAPA"
              android:textStyle="bold"
              app:icon="@android:drawable/ic_dialog_map"
              app:iconGravity="textStart" />

        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Tarjeta de Aviso: Perfil Incompleto (Solo visible si el perfil del runner no está completo) -->
      <androidx.cardview.widget.CardView
          android:id="@+id/cardAvisoPerfil"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardCornerRadius="10dp"
          app:cardElevation="2dp"
          app:cardBackgroundColor="#FFF3E0"
          android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

          <ImageView
              android:layout_width="28dp"
              android:layout_height="28dp"
              android:src="@android:drawable/ic_dialog_alert"
              app:tint="#E65100" />

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginStart="12dp"
              android:text="Tu perfil de runner está incompleto. Puedes explorar el evento en modo lectura, pero para inscribirte debes completar tus datos en 'Mi Perfil'."
              android:textColor="#E65100"
              android:textSize="13sp"
              android:textStyle="bold" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Tarjeta 2: Descripción -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Descripción"
              android:textSize="16sp"
              android:textStyle="bold"
              android:textColor="@color/black" />

          <TextView
              android:id="@+id/tvDescripcionDetalle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="..."
              android:textSize="14sp"
              android:textColor="#424242" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Tarjeta 3: Organizador y Datos de Pago -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Organizador y Pago"
              android:textSize="16sp"
              android:textStyle="bold"
              android:textColor="@color/black" />

          <TextView
              android:id="@+id/tvOrganizadorDetalle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Organizado por: ---"
              android:textSize="14sp"
              android:textColor="#424242" />

          <TextView
              android:id="@+id/tvDatosPagoDetalle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="Datos de pago: ---"
              android:textSize="14sp"
              android:textColor="#424242" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Sección Categorías -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          android:text="Categorías Disponibles"
          android:textSize="18sp"
          android:textStyle="bold"
          android:textColor="@color/black" />

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvCategoriasRunner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:nestedScrollingEnabled="false" />

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <ProgressBar
      android:id="@+id/progressBarDetalle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
