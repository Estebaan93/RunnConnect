<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.notificaciones.NotificacionesFragment">

  <!-- Mensaje de Error persistente (Regla 7) -->
  <TextView
      android:id="@+id/tvErrorNotificaciones"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_margin="12dp"
      android:background="#FFCDD2"
      android:padding="10dp"
      android:text=""
      android:textColor="#B71C1C"
      android:textSize="13sp"
      android:visibility="gone"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- Listado de Notificaciones -->
  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvNotificaciones"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginTop="6dp"
      android:clipToPadding="false"
      android:paddingBottom="16dp"
      app:layout_constraintTop_toBottomOf="@id/tvErrorNotificaciones"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- Mensaje de Buzón Vacío persistente (Regla 7) -->
  <TextView
      android:id="@+id/tvVacioNotificaciones"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="No tienes notificaciones en este momento"
      android:textColor="#757575"
      android:textSize="15sp"
      android:visibility="gone"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- ProgressBar de Carga -->
  <ProgressBar
      android:id="@+id/progressBarNotificaciones"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:visibility="gone"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
