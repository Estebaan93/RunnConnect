<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.runner.misResultados.MisResultadosFragment">

  <!-- Card de Estadísticas Acumuladas -->
  <androidx.cardview.widget.CardView
      android:id="@+id/cardEstadisticas"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_margin="12dp"
      app:cardCornerRadius="12dp"
      app:cardElevation="3dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

      <TextView
          android:id="@+id/tvTituloEstadisticas"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Resumen de Rendimiento"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="@color/black" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginTop="10dp"
          android:weightSum="2">

        <!-- Métricas: Carreras -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E8F5E9">

          <TextView
              android:id="@+id/tvCarrerasCount"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="0"
              android:textSize="22sp"
              android:textStyle="bold"
              android:textColor="#2E7D32" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Carreras"
              android:textSize="12sp"
              android:textColor="#388E3C" />
        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Métricas: Mejor Puesto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="#FFF3E0">

          <TextView
              android:id="@+id/tvMejorPuestoCount"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="-"
              android:textSize="22sp"
              android:textStyle="bold"
              android:textColor="#E65100" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Mejor Puesto"
              android:textSize="12sp"
              android:textColor="#EF6C00" />
        </LinearLayout>

      </LinearLayout>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Mensaje de Error persistente (Regla 7) -->
  <TextView
      android:id="@+id/tvErrorResultados"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="12dp"
      android:layout_marginTop="4dp"
      android:background="#FFCDD2"
      android:padding="10dp"
      android:text=""
      android:textColor="#B71C1C"
      android:textSize="13sp"
      android:visibility="gone"
      app:layout_constraintTop_toBottomOf="@id/cardEstadisticas"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- Listado de Resultados -->
  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvMisResultados"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginTop="6dp"
      android:clipToPadding="false"
      android:paddingBottom="16dp"
      app:layout_constraintTop_toBottomOf="@id/tvErrorResultados"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- Mensaje de Lista Vacía persistente (Regla 7) -->
  <TextView
      android:id="@+id/tvVacioResultados"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Aún no tienes resultados registrados"
      android:textColor="#757575"
      android:textSize="15sp"
      android:visibility="gone"
      app:layout_constraintTop_toBottomOf="@id/cardEstadisticas"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- ProgressBar de Carga -->
  <ProgressBar
      android:id="@+id/progressBarResultados"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:visibility="gone"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>