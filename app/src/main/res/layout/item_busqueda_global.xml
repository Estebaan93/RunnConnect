<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- nombre del runner -->
        <TextView
            android:id="@+id/tvRunnerNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Juan Perez"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- DNI -->
        <TextView
            android:id="@+id/tvRunnerDni"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="DNI: 12345678"
            android:textSize="12sp"
            android:textColor="#666"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRunnerNombre" />

        <!-- evento y Categoria -->
        <TextView
            android:id="@+id/tvEventoCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Maratón San Luis - 10K"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="#2196F3"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRunnerDni" />

        <!-- estado de pago -->
        <TextView
            android:id="@+id/tvEstadoPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="PAGADO"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEventoCategoria" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>