<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

  <TextView
      android:id="@+id/tvDialogTitulo"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Inscripción a Categoría"
      android:textSize="18sp"
      android:textStyle="bold"
      android:textColor="@color/black" />

  <TextView
      android:id="@+id/tvDialogPrecio"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Costo: $0.00"
      android:textSize="15sp"
      android:textStyle="bold"
      android:textColor="#2E7D32" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="Talle de Remera:"
      android:textSize="14sp"
      android:textStyle="bold"
      android:textColor="@color/black" />

  <Spinner
      android:id="@+id/spDialogTalleRemera"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="6dp"
      android:background="@drawable/bg_spinner_border"
      android:paddingHorizontal="12dp" />

  <CheckBox
      android:id="@+id/cbDialogDeslinde"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="Acepto el deslinde de responsabilidades y reglamento del evento."
      android:textSize="14sp"
      android:textColor="@color/black" />

  <TextView
      android:id="@+id/tvDialogError"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="#C62828"
      android:textSize="13sp"
      android:textStyle="bold"
      android:visibility="gone" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:layout_marginTop="20dp"
      android:gravity="end">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogCancelar"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        android:textColor="#757575" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogConfirmar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Confirmar"
        android:backgroundTint="@color/purple_700"
        android:textColor="@color/white" />
  </LinearLayout>

</LinearLayout>
